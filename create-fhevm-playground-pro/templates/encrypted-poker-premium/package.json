{
  "name": "fhevm-example",
  "version": "1.0.0",
  "description": "fhEVM Example Project",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat compile && (ls test/*.test.* >/dev/null 2>&1 && NODE_NO_WARNINGS=1 TS_NODE_TRANSPILE_ONLY=true mocha -r ts-node/register/transpile-only -r hardhat/register 'test/**/*.test.ts' 2>&1 | grep -v MODULE_TYPELESS || echo 'No test files found')"
  },
  "keywords": ["fhevm", "hardhat", "solidity"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fhevm": "file:../../../fhevm"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.1.0",
    "@fhevm/solidity": "^0.10.0",
    "@fhevm/mock-utils": "^0.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^3.0.8",
    "@types/chai": "^5.2.3",
    "@types/node": "^20.10.6",
    "@zama-fhe/oracle-solidity": "^0.1.0",
    "@zama-fhe/relayer-sdk": "^0.2.0",
    "chai": "^6.2.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.10",
    "mocha": "^10.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
