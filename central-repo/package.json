{
  "name": "create-fhevm-playground-pro",
  "type": "module",
  "version": "1.0.51",
  "description": "Premium CLI scaffolding tool for fhEVM examples - Zama's December 2025 Bounty Track",
  "main": "dist/src/cli.js",
  "bin": {
    "create-fhevm-playground-pro": "dist/bin/create-fhevm-playground-pro.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run test:mock",
    "test:examples": "bash ../scripts/run-all-example-tests.sh",
    "test:mock": "MOCK=true npx hardhat test",
    "start": "npm run build && node dist/bin/create-fhevm-playground-pro.js",
    "batch-update": "npx ts-node scripts/batch-update-fhevm-version.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "fhEVM",
    "FHE",
    "homomorphic encryption",
    "confidential computing",
    "Zama",
    "Hardhat",
    "scaffolding",
    "CLI"
  ],
  "author": "Zama Community",
  "license": "MIT",
  "dependencies": {
    "@fhevm/hardhat-plugin": "^0.1.0",
    "@fhevm/solidity": "^0.10.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.7"
  },
  "devDependencies": {
    "@fhevm/mock-utils": "^0.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^3.0.8",
    "@types/chai": "^5.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.6",
    "@zama-fhe/oracle-solidity": "^0.1.0",
    "@zama-fhe/relayer-sdk": "^0.2.0",
    "chai": "^6.2.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.2",
    "hardhat-ethers": "^1.0.1",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zama-ai/fhevm-playground-pro.git"
  },
  "bugs": {
    "url": "https://github.com/zama-ai/fhevm-playground-pro/issues"
  },
  "homepage": "https://github.com/zama-ai/fhevm-playground-pro#readme"
}
